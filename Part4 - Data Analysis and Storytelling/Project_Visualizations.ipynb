    "import plotly.express as px\n",
    "import re\n",
    "\n",
    "# NEWEGG PRODUCT NAMING — Simple & clean\n",
    "def shorten_name_newegg(name):\n",
    "    parts = name.split()\n",
    "    final = [parts[0]]  # Manufacturer first\n",
    "\n",
    "    skip_words = [\n",
    "        \"GB\",\"Gen\",\"SSD\",\"GPU\",\"Memory\",\"RAM\",\"Wi-Fi\",\"WIFI\",\"Windows\",\n",
    "        \"Display\",\"Silver\",\"Black\",\"Gray\",\"Grade\",\"Intel\",\"Core\",\n",
    "        \"DDR\",\"PCIe\",\"Laptop\",\"Desktop\",\"Certified\",\"Refurbished\"\n",
    "    ]\n",
    "\n",
    "    for word in parts[1:]:\n",
    "        if any(unit in word for unit in skip_words):\n",
    "            continue\n",
    "        if len(final) < 3:\n",
    "            final.append(word)\n",
    "\n",
    "    return \" \".join(final)\n",
    "\n",
    "\n",
    "# BEST BUY PRODUCT NAMING — readable for normal people\n",
    "def clean_bestbuy_name(name):\n",
    "    # Example input:\n",
    "    # \"Apple - MacBook Air 13.3\\\" Laptop - M2 chip - 8GB Memory - 256GB SSD - Silver\"\n",
    "\n",
    "    # Extract product line\n",
    "    if \"MacBook Air\" in name:\n",
    "        product = \"MacBook Air\"\n",
    "    elif \"MacBook Pro\" in name:\n",
    "        product = \"MacBook Pro\"\n",
    "    else:\n",
    "        product = name.split()[1]\n",
    "\n",
    "    # Extract screen size like 13.3\"\n",
    "    size_match = re.search(r\"\\d{1,2}\\.\\d+\\\"\", name)\n",
    "    size = size_match.group().replace(\"\\\"\", \"\") if size_match else \"\"\n",
    "\n",
    "    # Extract CPU chip: M1 / M2 / M3 / M3 Pro / M3 Max\n",
    "    chip_match = re.search(r\"M\\d\\s?(Pro|Max)?\", name)\n",
    "    chip = chip_match.group() if chip_match else \"\"\n",
    "\n",
    "    # Build readable label\n",
    "    label = product\n",
    "    if size:\n",
    "        label += f\" {size}\\\"\"\n",
    "    if chip:\n",
    "        label += f\" ({chip})\"\n",
    "\n",
    "    return label\n",
    "\n",
    "\n",
    "# APPLY NAME FORMATTING\n",
    "best_sellers[\"short_name\"] = best_sellers[\"name\"].apply(shorten_name_newegg)\n",
    "best_sellers_bb[\"short_name\"] = best_sellers_bb[\"name\"].apply(clean_bestbuy_name)\n",
    "\n",
    "\n",
    "# NEWEGG — Interactive Chart\n",
    "fig_newegg = px.bar(\n",
    "    best_sellers,\n",
    "    x=\"customerReviewCount\",\n",
    "    y=\"short_name\",\n",
    "    orientation=\"h\",\n",
    "    text=best_sellers[\"customerReviewAverage\"].apply(lambda r: f\"{r:.1f}★\"),\n",
    "    color=\"customerReviewAverage\",\n",
    "    color_continuous_scale=\"RdYlGn\",\n",
    "    range_color=[4.0, 5.0],\n",
    "    title=\"Top 10 Best Selling Products on Newegg\",\n",
    "    labels={\n",
    "        \"customerReviewCount\": \"Number of Reviews\",\n",
    "        \"short_name\": \"Product\",\n",
    "        \"customerReviewAverage\": \"Rating\"\n",
    "    }\n",
    ")\n",
    "\n",
    "fig_newegg.update_traces(textposition=\"outside\")\n",
    "fig_newegg.update_layout(height=600, font=dict(size=12))\n",
    "fig_newegg.show()\n",
    "\n",
    "\n",
    "# BEST BUY — Interactive Chart\n",
    "fig_bestbuy = px.bar(\n",
    "    best_sellers_bb,\n",
    "    x=\"customerReviewCount\",\n",
    "    y=\"short_name\",\n",
    "    orientation=\"h\",\n",
    "    text=best_sellers_bb[\"customerReviewAverage\"].apply(lambda r: f\"{r:.1f}★\"),\n",
    "    color=\"customerReviewAverage\",\n",
    "    color_continuous_scale=\"RdYlGn\",\n",
    "    range_color=[4.0, 5.0],\n",
    "    title=\"Top 10 Best Selling Products on Best Buy\",\n",
    "    labels={\n",
    "        \"customerReviewCount\": \"Number of Reviews\",\n",
    "        \"short_name\": \"Product\",\n",
    "        \"customerReviewAverage\": \"Rating\"\n",
    "    }\n",
    ")\n",
    "\n",
    "fig_bestbuy.update_traces(textposition=\"outside\")\n",
    "fig_bestbuy.update_layout(height=600, font=dict(size=12))\n",
    "fig_bestbuy.show()\n",
    "\n",
    "print(\"\"\"Although Newegg and Best Buy serve different consumer markets, data from both platforms \n",
    "shows the same trend: customers are far more likely to leave a review when their experience \n",
    "is positive rather than negative.\"\"\")\n"
   ]
