   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import plotly.express as go\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "\n",
    "manufacturer_sales = best_buy.groupby(\"manufacturer\")[\"salePrice\"].sum()\n",
    "manufacturer_reviews = best_buy.groupby(\"manufacturer\")[\"customerReviewCount\"].sum()\n",
    "\n",
    "manufacturers = manufacturer_sales.index.tolist()\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "# Sales bar\n",
    "fig.add_trace(go.Bar(\n",
    "    x=manufacturers,\n",
    "    y=manufacturer_sales,\n",
    "    name=\"Total Sales ($)\",\n",
    "))\n",
    "\n",
    "# Reviews bar\n",
    "fig.add_trace(go.Bar(\n",
    "    x=manufacturers,\n",
    "    y=manufacturer_reviews,\n",
    "    name=\"Total Reviews\",\n",
    "))\n",
    "\n",
    "fig.update_layout(\n",
    "    title=\"Total Sales vs Total Reviews by Manufacturer (BEST BUY)\",\n",
    "    xaxis_title=\"Manufacturer\",\n",
    "    yaxis_title=\"Values\",\n",
    "    barmode=\"group\",   # side-by-side bars\n",
    "    hovermode=\"x unified\",\n",
    "    height=600\n",
    ")\n",
    "\n",
    "fig.show()\n",
    "\n",
    "\n",
    "# Filter rows with ratings 4 stars or higher\n",
    "positive_df = best_buy[best_buy[\"customerReviewAverage\"] >= 4]\n",
    "\n",
    "# Aggregate positive reviews & sales\n",
    "positive_sales = positive_df.groupby(\"manufacturer\")[\"salePrice\"].sum()\n",
    "positive_reviews = positive_df.groupby(\"manufacturer\")[\"customerReviewCount\"].sum()\n",
    "\n",
    "manufacturers = positive_sales.index.tolist()\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "# Positive Sales bar\n",
    "fig.add_trace(go.Bar(\n",
    "    x=manufacturers,\n",
    "    y=positive_sales,\n",
    "    name=\"Positive Sales ($) — 4★+ Products\",\n",
    "))\n",
    "\n",
    "# Positive Reviews bar\n",
    "fig.add_trace(go.Bar(\n",
    "    x=manufacturers,\n",
    "    y=positive_reviews,\n",
    "    name=\"Positive Reviews — 4★+ Products\",\n",
    "))\n",
    "\n",
    "fig.update_layout(\n",
    "    title=\"Total Sales vs Positive Reviews (4★+) by Manufacturer (BEST BUY)\",\n",
    "    xaxis_title=\"Manufacturer\",\n",
    "    yaxis_title=\"Values\",\n",
    "    barmode=\"group\",\n",
    "    hovermode=\"x unified\",\n",
    "    height=600\n",
    ")\n",
    "\n",
    "fig.show()\n",
    "\n",
    "\n",
    "# Filter rows with ratings 4 stars or lower\n",
    "negative_df = best_buy[best_buy[\"customerReviewAverage\"] < 3]\n",
    "\n",
    "# Aggregate negative reviews & sales\n",
    "negative_sales = negative_df.groupby(\"manufacturer\")[\"salePrice\"].sum()\n",
    "negative_reviews = negative_df.groupby(\"manufacturer\")[\"customerReviewCount\"].sum()         \n",
    "manufacturers = negative_sales.index.tolist()\n",
    "fig = go.Figure()\n",
    "\n",
    "# Negative Sales bar\n",
    "fig.add_trace(go.Bar(\n",
    "    x=manufacturers,\n",
    "    y=negative_sales,\n",
    "    name=\"Negative Sales ($) less than 3★ Products\",\n",
    "))\n",
    "\n",
    "# Negative Reviews bar\n",
    "fig.add_trace(go.Bar(\n",
    "    x=manufacturers,\n",
    "    y=negative_reviews,\n",
    "    name=\"Negative Reviews less than 3★ Products\",\n",
    "))  \n",
    "\n",
    "fig.update_layout(\n",
    "    title=\"Total Sales vs Negative Reviews (<3★) by Manufacturer (BEST BUY)\",\n",
    "    xaxis_title=\"Manufacturer\",\n",
    "    yaxis_title=\"Values\",\n",
    "    barmode=\"group\",\n",
    "    hovermode=\"x unified\",\n",
    "    height=600\n",
    ")\n",
    "\n",
    "fig.show()\n",
    "\n",
    "print(\"\"\"This analysis demonstrates that manufacturers with higher positive product ratings not only \n",
    "generate more reviews but also achieve stronger overall sales, whereas low-rated products contribute \n",
    "far fewer reviews and significantly less revenue. This suggests a strong correlation between positive \n",
    "customer sentiment, review engagement, and commercial performance.\"\"\")\n"
   ]
  },
