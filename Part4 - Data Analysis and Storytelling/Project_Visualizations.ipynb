    "# Round ratings to nearest whole star\n",
    "best_buy[\"ratingRounded\"] = best_buy[\"customerReviewAverage\"].round()\n",
    "\n",
    "# Sum total review counts per star level\n",
    "rating_sums = best_buy.groupby(\"ratingRounded\")[\"customerReviewCount\"].sum()\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(8,8))\n",
    "plt.pie(rating_sums, labels=rating_sums.index.astype(str) + \"★\", autopct='%1.1f%%')\n",
    "plt.title(\"Distribution of Total Reviews by Star Rating Best Buy\")\n",
    "plt.show()\n",
    "\n",
    "# Round ratings to nearest whole star\n",
    "new_egg[\"ratingRounded\"] = new_egg[\"customerReviewAverage\"].round()\n",
